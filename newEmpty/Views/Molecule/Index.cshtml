@model IEnumerable<Molecule>
@{
    <html>

    <head>
        <title>Index</title>
    </head>

    <body>
        <h1 class="centrer">Gestion des molécules</h1>

        <input type="text" id="EntreeRecherche" placeholder="Rechercher... ">

        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th scope="col">Nom</th>
                    <th scope="col"> Retirer un profil</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var molecule in Model)
                {
                    <tr class="element">
                        <td></td>
                        <td scope="row" class="text_search">@molecule.Nom</td>
                        <td scope="row"><a asp-controller="Molecule" asp-action="Remove" asp-route-id="@molecule.Moleculeid">
                                Retirer</a> </td>
                    </tr>
                }
            </tbody>
        </table>

        <div>
            <button type="button" class="btn btn-light">
                <a asp-controller="Molecule" asp-action="Add"> Ajouter une molécule </a>
            </button>
        </div>
        <script>
            document.getElementById('EntreeRecherche').addEventListener('keyup', function () {

                var texteRecherche = this.value.toLowerCase();
                var Element = document.querySelectorAll('.element');

                Element.forEach(function (card) {
                    var Molecule = card.querySelector('.text_search').textContent.toLowerCase(); //case a rechercher
                    if (Moleculze.includes(texteRecherche)) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });

        </script>
    </body>



    </html>


}
