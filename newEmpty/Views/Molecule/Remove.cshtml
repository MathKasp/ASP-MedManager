@model Molecule

<!DOCTYPE html>
<html lang="en">

    <head>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Retirer une molécule</title>

    </head>

    <body>
        <h1 class="centrer"> Etes vous certain de vouloir retirer cette Molécule ? </h1>
        
        <form asp-action="RemoveConfirm" method="post" class="centrer">

            <input asp-for="Moleculeid" type="hidden" />
            <div class="form-group">
                <label asp-for="@Model.Nom"></label> <input asp-for="@Model.Nom" class="form-control" />
            </div>

            <br>

            <div class="centrer">            
                <input type="submit" value="Oui je veux retirer cet élément" class="btn btn-danger" />
                <input type="button" onclick="history.back()" value="Non je ne veux plus" class="btn btn-secondary" />
            </div>
        </form>

    </body>

</html>